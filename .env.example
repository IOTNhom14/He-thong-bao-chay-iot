# Supabase Configuration (Lấy trong Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # Dùng Service Role Key để vượt RLS

# MQTT Broker Configuration
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_BROKER_USER=backend_worker
MQTT_BROKER_PASSWORD=backend_secret_mqtt_token_nhom14

# Telegram Alert Configuration
TELEGRAM_BOT_TOKEN=7123456789:AAH_your_telegram_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# Camera IP Webcam Configuration
CAMERA_SNAPSHOT_URL=http://192.168.1.238:8080/shot.jpg
CAMERA_STREAM_URL=http://192.168.55.104:8081/video
CAMERA_HTTP_USERNAME=admin
CAMERA_HTTP_PASSWORD=<set-locally>

# JWT Authentication Secret (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=<replace-with-openssl-rand-hex-32-min-32-chars>

