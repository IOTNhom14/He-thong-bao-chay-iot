# Supabase Configuration (Lấy trong Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # Dùng Service Role Key để vượt RLS

# MQTT Broker Configuration
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# Telegram Alert Configuration
TELEGRAM_BOT_TOKEN=7123456789:AAH_your_telegram_bot_token
TELEGRAM_CHAT_ID=-1001234567890